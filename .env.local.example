# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-Role-Key wird serverseitig für privilegierte Operationen genutzt
# (z. B. deleteAccountAction → auth.admin.deleteUser). NIEMALS im Client expose.
# Zu finden im Supabase Dashboard → Settings → API → Service role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for OAuth and email confirmation redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (PROJ-6)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Vapi (PROJ-12)
# VAPI_API_KEY=...

# Resend (PROJ-11)
# RESEND_API_KEY=re_...
