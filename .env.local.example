# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-Role-Key wird serverseitig für privilegierte Operationen genutzt
# (z. B. deleteAccountAction → auth.admin.deleteUser). NIEMALS im Client expose.
# Zu finden im Supabase Dashboard → Settings → API → Service role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for OAuth and email confirmation redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (PROJ-6)
# CRITICAL: KEINE NEXT_PUBLIC_-Variante für SECRET oder WEBHOOK_SECRET.
# Secrets ausschließlich server-seitig. Publishable-Key brauchen wir nicht,
# weil wir Hosted Checkout (Stripe-Redirect) statt eigener Elements nutzen.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_INITIAL=price_...   # 249 € Portal-Zugang Initial (12 Monate)
# STRIPE_PRICE_ID_RENEWAL=price_...   # 99 € Portal-Zugang Verlängerung (12 Monate)

# Resend / Transaktionsmails (PROJ-11)
# CRITICAL: niemals NEXT_PUBLIC_-Variante. Server-only.
# RESEND_API_KEY=re_...
# EMAIL_FROM='narravit <no-reply@mail.narravit.de>'   # muss auf der in Resend verifizierten Domain mail.narravit.de liegen
# EMAIL_TEST_RECIPIENT=qa+stage@narravit.de   # nur in stage/lokal setzen — leitet ALLE Mails auf diese Adresse um (in Vercel-Production ignoriert)
# CRON_SECRET=use_a_long_random_string        # Auth-Header für /api/cron/reminders
