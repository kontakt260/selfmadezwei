# PROJ-19: Der Build prüft diese Werte. Auf Stage und Production bricht er ab,
# wenn ein Pflichtwert fehlt, lokal gibt es nur eine Warnung.
# Neue Variable: zuerst in src/lib/config/build-config.ts und hier eintragen.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-Role-Key wird serverseitig für privilegierte Operationen genutzt
# (z. B. deleteAccountAction → auth.admin.deleteUser). NIEMALS im Client expose.
# Zu finden im Supabase Dashboard → Settings → API → Service role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for OAuth and email confirmation redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (PROJ-6)
# CRITICAL: KEINE NEXT_PUBLIC_-Variante für SECRET oder WEBHOOK_SECRET.
# Secrets ausschließlich server-seitig. Publishable-Key brauchen wir nicht,
# weil wir Hosted Checkout (Stripe-Redirect) statt eigener Elements nutzen.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_INITIAL=price_...   # 249 € Portal-Zugang Initial (12 Monate)
# STRIPE_PRICE_ID_RENEWAL=price_...   # 99 € Portal-Zugang Verlängerung (12 Monate)

# Resend / Transaktionsmails (PROJ-11)
# CRITICAL: niemals NEXT_PUBLIC_-Variante. Server-only.
# RESEND_API_KEY=re_...
# EMAIL_FROM='NARRAVIT <no-reply@mail.narravit.de>'   # Name in Großbuchstaben; Adresse muss auf der in Resend verifizierten Domain mail.narravit.de liegen
# EMAIL_TEST_RECIPIENT=qa+stage@narravit.de   # nur in stage/lokal setzen — leitet ALLE Mails auf diese Adresse um (auf app.narravit.de ignoriert)
# CRON_SECRET=use_a_long_random_string        # Auth-Header für /api/cron/reminders

# Rate-Limiting und Sicherheitsprüfung (PROJ-17)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # öffentlicher Testschlüssel von Cloudflare (besteht immer); in Production der echte Site Key
# RATE_LIMIT_DISABLED=true                                  # nur lokal: schaltet die Limits ab, wird in Production ignoriert

# Willkommens-Rabatt (PROJ-11)
# WELCOME_DISCOUNT_CODE=BUCH50       # Stripe-Promotion-Code (50 €, nur Erstkauf) für die Willkommens-Mail; ohne Wert erscheint kein Rabatt
